[Unit]
Description=InnerCore Backend (FastAPI)
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/srv/sleep-prod/backend/backend
ExecStart=/srv/sleep-prod/backend/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/srv/sleep-prod/backend/backend

[Install]
WantedBy=multi-user.target